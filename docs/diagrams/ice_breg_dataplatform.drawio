          <mxGeometry height="75" width="490" x="1015" y="845" as="geometry" />
        </mxCell>
        <mxCell id="c_s3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;fontSize=12;align=left;verticalAlign=middle;spacingLeft=64;strokeColor=#7AA116;strokeWidth=2;fillColor=#F2F6E8;" value="&lt;b&gt;s3://…-warehouse&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 10px; color: #5A6C7D;&quot;&gt;Iceberg metadata + Parquet · partitioned on trip_date · via the gateway endpoint, $0 transfer&lt;/span&gt;" vertex="1">
          <mxGeometry height="110" width="420" x="520" y="1240" as="geometry" />
        </mxCell>
        <mxCell id="c_rds" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;fontSize=12;align=left;verticalAlign=middle;spacingLeft=64;strokeColor=#2E73B8;strokeWidth=2;" value="&lt;b&gt;RDS PostgreSQL 17&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 10px; color: #5A6C7D;&quot;&gt;iceberg_catalog — every table pointer&lt;br&gt;airflow — scheduler metadata&lt;/span&gt;" vertex="1">
          <mxGeometry height="110" width="380" x="90" y="1240" as="geometry" />
