        <mxCell id="eks2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#232F3E;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#232F3E;" value="Amazon EKS · data-platform-prod — grouped by namespace" vertex="1">
