{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "PolarisWarehouseObjectAccess",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject"
      ],
      "Resource": [
        "arn:aws:s3:::data-store-prod-warehouse/bronze/*",
        "arn:aws:s3:::data-store-prod-warehouse/silver/*",
        "arn:aws:s3:::data-store-prod-warehouse/gold/*"
      ]
    },
    {
      "Sid": "PolarisWarehouseListing",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket"
      ],
      "Resource": "arn:aws:s3:::data-store-prod-warehouse",
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "bronze/*",
            "silver/*",
            "gold/*"
          ]
        }
      }
    }
  ]
}
