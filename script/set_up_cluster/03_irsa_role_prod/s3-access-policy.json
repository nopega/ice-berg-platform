{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListProdBuckets",
      "Effect": "Allow",
      "Action": ["s3:ListBucket"],
      "Resource": [
        "arn:aws:s3:::data-store-prod-warehouse",
        "arn:aws:s3:::data-store-prod-logs"
      ]
    },
    {
      "Sid": "ReadWriteProdObjects",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject"],
      "Resource": [
        "arn:aws:s3:::data-store-prod-warehouse/*",
        "arn:aws:s3:::data-store-prod-logs/*"
      ]
    }
  ]
}
