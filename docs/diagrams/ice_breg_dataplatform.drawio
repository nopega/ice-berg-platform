        <mxCell id="c_drv" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;fontSize=12;align=left;verticalAlign=middle;spacingLeft=64;strokeColor=#ED7100;strokeWidth=2;" value="&lt;b&gt;Spark driver&lt;/b&gt; — 4.0.1 + Iceberg 1.10.2&lt;br&gt;&lt;span style=&quot;font-size: 10px; color: #5A6C7D;&quot;&gt;on ng-ondemand (critical)&lt;br&gt;downloads its own code AND the TLC file&lt;br&gt;&lt;b&gt;bronze → silver → gold&lt;/b&gt;, one day per run&lt;/span&gt;" vertex="1">
          <mxGeometry height="110" width="330" x="115" y="790" as="geometry" />
        </mxCell>
        <mxCell id="c_exe" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;fontSize=12;align=left;verticalAlign=middle;spacingLeft=64;strokeColor=#879196;strokeWidth=2;dashed=1;" value="&lt;b&gt;Spark executors × 2&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 10px; color: #5A6C7D;&quot;&gt;on ng-spot, &lt;b&gt;0 → N → 0&lt;/b&gt;&lt;br&gt;taint tolerated; gone 5 min after the job&lt;/span&gt;" vertex="1">
          <mxGeometry height="110" width="330" x="115" y="925" as="geometry" />
        </mxCell>
        <mxCell id="ns_dp" parent="1" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;strokeColor=#879196;fillColor=#FBFBFB;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=11;fontColor=#5A6C7D;" value="namespace: data-platform" vertex="1">
          <mxGeometry height="780" width="420" x="520" y="360" as="geometry" />
        </mxCell>
        <mxCell id="c_tc" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;fontSize=12;align=left;verticalAlign=middle;spacingLeft=64;strokeColor=#2E73B8;strokeWidth=2;" value="&lt;b&gt;Trino coordinator × 1&lt;/b&gt; — 480&lt;br&gt;&lt;span style=&quot;font-size: 10px; color: #5A6C7D;&quot;&gt;password file (bcrypt) → file access rules&lt;br&gt;resource groups: Team A vs Team B&lt;br&gt;&lt;b&gt;the only door to the data&lt;/b&gt;&lt;/span&gt;" vertex="1">
          <mxGeometry height="110" width="370" x="545" y="410" as="geometry" />
        </mxCell>
        <mxCell id="c_tw" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;fontSize=12;align=left;verticalAlign=middle;spacingLeft=64;strokeColor=#2E73B8;strokeWidth=2;" value="&lt;b&gt;Trino workers 2 – 5&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 10px; color: #5A6C7D;&quot;&gt;HPA on CPU &amp;gt; 50% / mem &amp;gt; 80%&lt;br&gt;the answer to the 10 a.m. 100-query burst&lt;/span&gt;" vertex="1">
          <mxGeometry height="110" width="370" x="545" y="560" as="geometry" />
        </mxCell>
        <mxCell id="c_pol" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;fontSize=12;align=left;verticalAlign=middle;spacingLeft=64;strokeColor=#2E73B8;strokeWidth=3;fillColor=#EFF6FF;" value="&lt;b&gt;Apache Polaris 1.5.0&lt;/b&gt; — Iceberg REST catalog&lt;br&gt;&lt;span style=&quot;font-size: 10px; color: #5A6C7D;&quot;&gt;RBAC · atomic commits · &lt;b&gt;credential vending&lt;/b&gt;&lt;br&gt;holds no data — hands each engine short-lived, scoped S3 credentials&lt;/span&gt;" vertex="1">
          <mxGeometry height="140" width="370" x="545" y="960" as="geometry" />
        </mxCell>
        <mxCell id="ns_hb" parent="1" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;strokeColor=#879196;fillColor=#FBFBFB;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=11;fontColor=#5A6C7D;" value="namespace: harbor" vertex="1">
