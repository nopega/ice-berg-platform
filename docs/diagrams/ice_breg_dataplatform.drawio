  <diagram id="data-platform" name="Data Platform">
    <mxGraphModel dx="1852" dy="1257" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1840" pageHeight="1440" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t2" parent="1" style="text;html=1;align=left;verticalAlign=top;fontSize=26;fontColor=#232F3E;" value="&lt;b style=&quot;font-size: 26px;&quot;&gt;Data Platform — the Kubernetes layer&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color: #5A6C7D; font-size: 13px;&quot;&gt;what runs ON the infrastructure page: one catalog, a write path (Spark) and a read path (Trino) that only meet at Polaris&lt;/span&gt;" vertex="1">
          <mxGeometry height="60" width="1100" x="40" y="20" as="geometry" />
        </mxCell>
        <mxCell id="x_tlc" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;fontSize=12;align=left;verticalAlign=middle;spacingLeft=12;strokeColor=#5A6C7D;" value="&lt;b&gt;NYC TLC&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 10px; color: #5A6C7D;&quot;&gt;monthly Parquet over HTTPS&lt;/span&gt;" vertex="1">
          <mxGeometry height="60" width="270" x="150" y="100" as="geometry" />
        </mxCell>
        <mxCell id="x_users" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;fontSize=12;align=left;verticalAlign=middle;spacingLeft=12;strokeColor=#5A6C7D;align=left;spacingLeft=64;" value="&lt;b&gt;Users · BI clients&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 10px; color: #5A6C7D;&quot;&gt;Power BI · DBeaver · JDBC&lt;/span&gt;" vertex="1">
          <mxGeometry height="60" width="340" x="530" y="100" as="geometry" />
        </mxCell>
        <mxCell id="x_git" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;fontSize=12;align=left;verticalAlign=middle;spacingLeft=64;strokeColor=#8C4FFF;fillColor=#F5F0FF;" value="&lt;b&gt;GitHub — two repos, deliberately&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 10px; color: #5A6C7D;&quot;&gt;airflow_dag (what runs) · ice-berg-data-pipeline (the logic, fetched by the driver at submit)&lt;/span&gt;" vertex="1">
          <mxGeometry height="60" width="440" x="960" y="100" as="geometry" />
        </mxCell>
        <mxCell id="alb2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;fontSize=12;align=left;verticalAlign=middle;spacingLeft=64;strokeColor=#8C4FFF;strokeWidth=2;" value="&lt;b&gt;AWS ALB&lt;/b&gt; — trino · airflow · harbor · grafana · argocd · prometheus&lt;br&gt;&lt;span style=&quot;font-size: 10px; color: #5A6C7D;&quot;&gt;TLS ends here; HTTP + X-Forwarded-* inward&lt;/span&gt;" vertex="1">
          <mxGeometry height="70" width="340" x="530" y="200" as="geometry" />
