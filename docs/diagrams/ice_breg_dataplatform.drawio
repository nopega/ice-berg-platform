          <mxGeometry height="75" width="490" x="1015" y="405" as="geometry" />
        </mxCell>
        <mxCell id="ns_mo" parent="1" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;strokeColor=#879196;fillColor=#FBFBFB;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=11;fontColor=#5A6C7D;" value="namespace: monitoring" vertex="1">
          <mxGeometry height="220" width="540" x="990" y="540" as="geometry" />
        </mxCell>
        <mxCell id="c_prom" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;fontSize=12;align=left;verticalAlign=middle;spacingLeft=64;strokeColor=#879196;strokeWidth=2;" value="&lt;b&gt;Prometheus 3.13.2&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 10px; color: #5A6C7D;&quot;&gt;scrapes every namespace&lt;br&gt;7 d / 18 GiB on a 20 GiB PVC&lt;br&gt;single replica — RWO volume&lt;/span&gt;" vertex="1">
          <mxGeometry height="150" width="235" x="1015" y="585" as="geometry" />
        </mxCell>
