        <mxCell id="c_af" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;fontSize=12;align=left;verticalAlign=middle;spacingLeft=64;strokeColor=#ED7100;strokeWidth=2;" value="&lt;b&gt;Airflow 3.2.2&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 10px; color: #5A6C7D;&quot;&gt;KubernetesExecutor · DAGs by git-sync&lt;br&gt;creates a SparkApplication object — &lt;b&gt;never a pod&lt;/b&gt;&lt;br&gt;SMTP failure alerts, on final failure only&lt;/span&gt;" vertex="1">
          <mxGeometry height="115" width="330" x="115" y="405" as="geometry" />
